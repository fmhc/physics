.kurven[] | "| \(.k) | \(.n) | \(.w2_max * 1e6 | round / 1e6) .. \(.w2_min * 1e6 | round / 1e6) | \(.R[0] * 100 | round / 100) .. \(.R[-1] * 100 | round / 100) | \(if .dR_mittel then (.dR_mittel * 1000 | round / 1000) else "-" end) | \(if .cv_dR then (.cv_dR * 1000 | round / 1000) else "-" end) | \(if .dR_min then "\(.dR_min * 1000 | round / 1000) / \(.dR_max * 1000 | round / 1000)" else "-" end) | \(.umlauf_wechselt) | \(.R | map(. * 100 | round / 100 | tostring) | join(" ")) |"
