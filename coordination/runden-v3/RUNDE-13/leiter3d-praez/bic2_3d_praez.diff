+    alle_aufgeloest = bool(alle_rechtecke) and all(r.get("aufgeloest") is True for r in alle_rechtecke)
+    vollst = len(stufen) == 2 and all(p.get("profile_vollstaendig") for p in stufen)
+    erg["vollstaendig"] = vollst
