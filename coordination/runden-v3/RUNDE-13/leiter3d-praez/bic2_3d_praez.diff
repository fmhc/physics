+
+    def umlauf_pm1(r):
+        return r.get("aufgeloest") is True and "umlauf" in r and abs(abs(r["umlauf"]) - 1.0) < 0.1
+
+    def kand(p):
+        """Wechsel des Zielasts mit zugehoerigem Rechteck."""
+        rw = [r for r in p.get("rechtecke", []) if r.get("art") == "wechsel"]
+        aus = []
+        for k, w in enumerate(p.get("ziel_wechsel", [])):
+            r = rw[k] if k < len(rw) else {"fehler": "kein Rechteck"}
+            aus.append((w, r))
+        return aus
