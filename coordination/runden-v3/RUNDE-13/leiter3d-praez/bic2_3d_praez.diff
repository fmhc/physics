+def praez_wechsel(xs, ast, i):
+    """Vorzeichenwechsel von s zwischen den Zeilen i und i + 1 eines Astes (ast[i] = Nullstelle oder None)."""
+    k1, k2 = ast[i], ast[i + 1]
+    t_ = k1["s"] / (k1["s"] - k2["s"])
+    return {"i": i, "x_lo": xs[i], "x_hi": xs[i + 1], "x_stern": xs[i] + t_ * (xs[i + 1] - xs[i]),
+            "rho_stern": k1["rho"] + t_ * (k2["rho"] - k1["rho"]), "s_lo": k1["s"], "s_hi": k2["s"],
+            "steigung_rho_x": (k2["rho"] - k1["rho"]) / (xs[i + 1] - xs[i]),
+            "kernwachstum_kandidat": max(k1["wachstum"], k2["wachstum"]),
+            "ausloeschung_kandidat": max(k1["ausloeschung"], k2["ausloeschung"])}
+
