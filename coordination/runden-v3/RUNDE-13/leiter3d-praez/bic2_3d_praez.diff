+def praez_rechteck(L, xs, reihen, rc, drho, ns, runden, nu):
+    """PRAEZ3D: Umlauf von W auf dem Rechteck [x(reihen[0]), x(reihen[-1])] x [rc - drho, rc + drho] wie
+    umlauf_rechteck (gleicher Pfad, gegen den Uhrzeigersinn), aber mit expliziten Zeilen, freiem drho und `runden`
+    Halbierungsrunden der rho-Seiten (Schwelle 0,3 rad wie dort). Aufgeloest: groesster Phasensprung < 0,4 rad."""
+    t0 = uhr()
+    x_lo, x_hi = reihen[0], reihen[-1]
+    r_lo, r_hi = rc - drho, rc + drho
+    pfad = []
+    for i in reihen:                                # unten: rho = r_lo, x steigt
+        pfad.append((r_lo, i))
+    for k in range(1, ns):                          # rechts: x = x_hi, rho steigt
+        pfad.append((r_lo + 2.0 * drho * k / ns, x_hi))
+    for i in reversed(reihen):                      # oben: rho = r_hi, x faellt
+        pfad.append((r_hi, i))
+    for k in range(1, ns):                          # links: x = x_lo, rho faellt
+        pfad.append((r_hi - 2.0 * drho * k / ns, x_lo))
+    W, wa, _ = praez_W(L, [p[0] for p in pfad], [p[1] for p in pfad], nu)
+    benutzt = 0
+    for rnd in range(runden):
+        neu = []
+        for k in range(len(pfad)):
+            k2 = (k + 1) % len(pfad)
+            if pfad[k][1] == pfad[k2][1] and abs(cmath.phase(W[k2] * W[k].conjugate())) > 0.3:
+                neu.append(k)
+        if not neu:
+            break
+        benutzt = rnd + 1
+        mitte = [(0.5 * (pfad[k][0] + pfad[(k + 1) % len(pfad)][0]), pfad[k][1]) for k in neu]
+        Wn, wn_, _ = praez_W(L, [p[0] for p in mitte], [p[1] for p in mitte], nu)
+        p2, w2l, a2 = [], [], []
+        j = 0
+        for k in range(len(pfad)):
+            p2.append(pfad[k])
+            w2l.append(W[k])
+            a2.append(wa[k])
+            if j < len(neu) and neu[j] == k:
+                p2.append(mitte[j])
+                w2l.append(Wn[j])
+                a2.append(wn_[j])
+                j += 1
+        pfad, W, wa = p2, w2l, a2
+    u, sprung = umlauf(W)
+    # Spruenge je Seite: gleiche Zeile = rho-Seite, sonst omega^2-Seite (unten/oben nach rho)
+    seiten = {"unten": 0.0, "rechts": 0.0, "oben": 0.0, "links": 0.0}
+    for k in range(len(pfad)):
+        k2 = (k + 1) % len(pfad)
+        sp = abs(cmath.phase(W[k2] * W[k].conjugate()))
+        if pfad[k][1] == pfad[k2][1]:
+            s_ = "rechts" if pfad[k][1] == x_hi and x_hi != x_lo else "links"
+        else:
+            s_ = "unten" if abs(pfad[k][0] - r_lo) < 0.5 * drho else "oben"
+        seiten[s_] = max(seiten[s_], sp)
+    # Gegenprobe ohne Phasenaufloesung (wie afm_bic): (1/2) sum sgn L(y_a) sgn(Delta L(y_b)) an Wechseln von L(y_b)
+    kr = 0.0
+    for k in range(len(W)):
+        w1, w2_ = W[k], W[(k + 1) % len(W)]
+        if w1.imag * w2_.imag < 0:
+            t_ = w1.imag / (w1.imag - w2_.imag)
+            la = w1.real + t_ * (w2_.real - w1.real)
+            kr += 0.5 * (1.0 if la > 0 else -1.0) * (1.0 if w2_.imag > w1.imag else -1.0)
+    return {"x_lo": xs[x_lo], "x_hi": xs[x_hi], "reihen": list(reihen), "rho_lo": r_lo, "rho_hi": r_hi, "rho_c": rc,
+            "drho": drho, "umlauf": u, "umlauf_kreuzung": kr, "max_sprung": sprung, "aufgeloest": sprung < 0.4,
+            "max_sprung_seiten": seiten, "punkte": len(pfad), "runden_benutzt": benutzt, "runden_max": runden,
+            "min_absW": min(abs(w) for w in W), "median_absW": sorted(abs(w) for w in W)[len(W) // 2],
+            "wachstum_max_pfad": max(wa), "sek": uhr() - t0}
+
