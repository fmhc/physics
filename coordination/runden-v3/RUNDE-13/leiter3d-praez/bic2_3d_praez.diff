+def regel(a, zeilen, erg):
+    """PRAEZ3D: Regel der KARTE LEITER-3D-PRAEZ auf die praez-Ausgaben der Stufen h und h/2 einer Stelle."""
+    stufen = []
+    for fn in [v for v in a.dateien.split(",") if v]:
