+                 "aufgeloest1": r1.get("aufgeloest"), "aufgeloest2": r2.get("aufgeloest"),
+                 "kw1": w1["kernwachstum_kandidat"], "kw2": w2["kernwachstum_kandidat"]}
+            b["umlauf_ok"] = umlauf_pm1(r1) and umlauf_pm1(r2)
+            b["lage_ok"] = abs(b["abst1"]) <= 3e-4 and abs(b["abst2"]) <= 3e-4 and abs(b["stufen_diff"]) <= 1e-4
+            b["kw_ok"] = b["kw1"] <= 1e8 and b["kw2"] <= 1e8
+            paare.append(b)
+    erg["paare"] = paare
+    gesehen_kern = any(b["umlauf_ok"] and b["lage_ok"] for b in paare)
+    kein_wechsel = len(stufen) == 2 and all(not p.get("ziel_wechsel") for p in stufen)
+    kw_ohne = [p.get("kandidat_ohne_wechsel", {}).get("kernwachstum_kandidat") for p in stufen]
+    pol_r = [r for p in stufen for r in p.get("rechtecke", []) if r.get("art") == "pol"]
+    nicht = (vollst and kein_wechsel and len(pol_r) == 2 and all(r.get("aufgeloest") is True and
+                                                                 abs(r.get("umlauf", 9.0)) < 0.1 for r in pol_r)
