+def praez_W(L, rhos, ixs, nu, stapel=3000):
+    """PRAEZ3D: W = L(y_a) + i L(y_b) (Realteile wie in kurve), Kernwachstum und la_terme bei reellem rho, in Stapeln."""
+    W, wa, te = [], [], []
+    for s0_ in range(0, len(rhos), stapel):
+        r_ = rhos[s0_:s0_ + stapel]
+        Dw = direkt_m(L, [complex(v, 0.0) for v in r_], ixs[s0_:s0_ + stapel], [nu] * len(r_), gram=False)
+        W += [complex(float(Dw["la"][k].real), float(Dw["lb"][k].real)) for k in range(len(r_))]
+        wa += [float(v) for v in Dw["wachstum"].tolist()]
+        te += [float(v) for v in Dw["la_terme"].tolist()]
+    return W, wa, te
+
+
+def praez_illinois(L, kl, nu, iters, tol):
+    """PRAEZ3D: Nullstellen von L(y_b) in rho fuer alle Klammern [a, b, fa, fb, ix] gemeinsam (Illinois, wie
+    afm_bic.lokalisieren). Ergebnis je Klammer: letzte ausgewertete Stelle (rho, s = L(y_a) dort, Rest L(y_b))."""
+    kl = [list(k) for k in kl]
+    n = len(kl)
+    fertig = [False] * n
+    letzt = [None] * n
+    n_it = [0] * n
+    for it in range(iters):
+        aktiv = [i for i in range(n) if not fertig[i]]
+        if not aktiv:
+            break
+        xn = []
+        for i in aktiv:
+            a_, b_, fa, fb, _ = kl[i]
+            x = b_ - fb * (b_ - a_) / (fb - fa) if fb != fa else 0.5 * (a_ + b_)
+            if not (min(a_, b_) < x < max(a_, b_)):
+                x = 0.5 * (a_ + b_)
+            xn.append(x)
+        W, wa, te = praez_W(L, xn, [kl[i][4] for i in aktiv], nu)
+        for q, i in enumerate(aktiv):
+            a_, b_, fa, fb, ix = kl[i]
+            x, fx = xn[q], W[q].imag
+            letzt[i] = {"rho": x, "W": W[q], "wachstum": wa[q], "terme_a": te[q]}
+            n_it[i] = it + 1
+            if not math.isfinite(fx) or not math.isfinite(W[q].real):
+                fertig[i] = True
+                letzt[i]["fehler"] = "W nicht endlich"
+                continue
+            if fx == 0.0:
+                kl[i] = [x, x, 0.0, 0.0, ix]
+                fertig[i] = True
+                continue
+            if fx * fb < 0:
+                a_, fa = b_, fb
+            else:
+                fa = 0.5 * fa
+            b_, fb = x, fx
+            kl[i] = [a_, b_, fa, fb, ix]
+            if abs(b_ - a_) <= tol * max(1.0, abs(b_)):
+                fertig[i] = True
+    aus = []
+    for i in range(n):
+        if letzt[i] is None:
+            aus.append({"fehler": "keine Iteration", "konvergiert": False})
+            continue
+        aus.append({"rho": letzt[i]["rho"], "s": letzt[i]["W"].real, "lb_rest": letzt[i]["W"].imag,
+                    "wachstum": letzt[i]["wachstum"], "terme_a": letzt[i]["terme_a"],
+                    "klammer_end": abs(kl[i][1] - kl[i][0]), "iter": n_it[i],
+                    "konvergiert": bool(fertig[i] and "fehler" not in letzt[i]), "fehler": letzt[i].get("fehler")})
+    return aus
+
